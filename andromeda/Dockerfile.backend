FROM python:3.12-slim

WORKDIR /app

# Install curl for container healthcheck and compiler dependencies for faster-whisper/chromadb
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    playerctl \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies
COPY andromeda/backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend source and host controller modules
COPY andromeda/backend /app/andromeda/backend
COPY media_controller.py /app/media_controller.py


# Create persistent data directory
RUN mkdir -p /app/andromeda/data/vector_store

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=120s --retries=5 \
  CMD curl -f http://localhost:8000/ || exit 1

CMD ["python", "-m", "uvicorn", "andromeda.backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
