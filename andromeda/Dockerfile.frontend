FROM nginx:alpine

# Copy built distribution assets
COPY andromeda/dist /usr/share/nginx/html

# Copy Nginx server configuration
COPY andromeda/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 5173

HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1:5173/ || exit 1
